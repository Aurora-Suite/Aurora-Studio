{
  "name": "montaje-studio",
  "productName": "Aurora Studio",
  "version": "1.0.0",
  "description": "Aurora Studio — editor de vídeo de la suite Aurora",
  "main": "electron/main.cjs",
  "author": "Aurora Suite",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && cross-env MONTAJE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "es.zyvera.aurora.studio",
    "productName": "Aurora Studio",
    "copyright": "© 2026 Aurora Suite",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "files": [
        "dist/**",
        "electron/**",
        "build/icon.ico",
        "build/icon.png",
        "package.json",
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/linux/**",
        "!node_modules/ffprobe-static/bin/win32/ia32/**"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "files": [
        "dist/**",
        "electron/**",
        "build/icon.ico",
        "build/icon.png",
        "package.json",
        "!node_modules/ffprobe-static/bin/win32/**",
        "!node_modules/ffprobe-static/bin/linux/**"
      ],
      "hardenedRuntime": false,
      "icon": "build/icon-mac.png"
    },
    "nsis": {
      "artifactName": "${productName} Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "aurora",
        "name": "Proyecto Aurora Studio",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
